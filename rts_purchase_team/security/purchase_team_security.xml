<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="1">

    <!-- NEW RULE: Purchase User sees only his own orders -->
    <record id="rts_purchase_user_own_orders_rule" model="ir.rule">
        <field name="name">Purchase User: Own Orders Only</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('purchase.group_purchase_user'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <!-- NEW RULE: Purchase All Documents → Team visibility -->
    <record id="rts_purchase_team_visibility_rule" model="ir.rule">
        <field name="name">Purchase All Documents: Team Access</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="domain_force">
            [
                '|','|',
                ('user_id', '=', user.id),
                ('purchase_team_id.user_ids', 'in', [user.id]),
                ('purchase_team_id.team_leader_id', '=', user.id)
            ]
        </field>
        <field name="groups" eval="[(4, ref('group_purchase_all_documents'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>

    <!-- Manager sees all -->
    <record id="rts_purchase_manager_all_rule" model="ir.rule">
        <field name="name">Purchase Manager: All orders</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('purchase.group_purchase_manager'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>

</data>
</odoo>
